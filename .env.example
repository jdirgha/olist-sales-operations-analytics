# Copy to .env and fill in real values. Never commit .env.

# --- Project analytics database (local PostgreSQL 17) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist_analytics
POSTGRES_USER=olist_analyst
POSTGRES_PASSWORD=change_me

LOG_LEVEL=INFO

# --- Airflow (Docker Compose) ---
# Host user id so files written to mounted folders are owned by you (run: id -u)
AIRFLOW_UID=501
# Password for Airflow's internal metadata database container
AIRFLOW_DB_PASSWORD=change_me
# Airflow web UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Any long random string, e.g. output of: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change_me
